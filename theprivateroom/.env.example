# THE PRIVATE ROOM — environment reference
#
# This is a dependency-free static site (no Node/build step), so these
# values are NOT read automatically from a .env file at runtime. They map
# 1:1 to the fields in assets/js/config.js — set them there, or wire this
# file into a bundler/edge-function later if the project migrates off
# static hosting. Keep both in sync either way.

# Booking calendar shown at /private-calendar/ once a request is approved.
CALENDAR_URL=

# Endpoint the application form (/apply/) POSTs to. Leave empty to keep the
# form in local demo mode (saves to localStorage only, never sends data out).
FORM_ENDPOINT=

# Analytics — scripts only load when an ID is present.
META_PIXEL_ID=
GA_MEASUREMENT_ID=
GTM_ID=

# Shared only after a private conversation confirms acceptance. Do not wire
# these into any public button.
FULL_PAYMENT_URL=
PAYMENT_PLAN_URL=

CONTACT_EMAIL=info@lindsytorres.com
WHATSAPP_NUMBER=

PRIVACY_POLICY_URL=/privacy/
TERMS_URL=/terms/
